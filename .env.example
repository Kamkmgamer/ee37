# UploadThing (get these from uploadthing.com dashboard)
UPLOADTHING_TOKEN="your_uploadthing_token_here"

# Semester-specific upload tokens (one per upload endpoint)
UPLOADTHING_TOKEN_S_1="your_uploadthing_token_for_semester_1"
UPLOADTHING_TOKEN_S_2="your_uploadthing_token_for_semester_2"
UPLOADTHING_TOKEN_S_3="your_uploadthing_token_for_semester_3"
UPLOADTHING_TOKEN_S_4="your_uploadthing_token_for_semester_4"
