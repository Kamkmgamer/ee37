# Application
NEXT_PUBLIC_URL="http://localhost:3000"

# Internal API (for Convex to fetch user data from PostgreSQL)
INTERNAL_API_KEY="your-secure-random-key-here-min-32-chars"

# Drizzle
DATABASE_URL="postgresql://postgres:password@localhost:5432/ee37"

# Resend (get from resend.com dashboard)
